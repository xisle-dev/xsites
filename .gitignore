# etl build artifact -- rebuild with: cd etl && go build -o etl.exe .
etl/etl.exe
etl/etl

# etl's raw-download cache and regenerable large output (the PMTiles
# archive, ~200MB, over GitHub's file size limit anyway). Regenerate with
# `etl airspace` / `etl tiles` -- see README.md. output/airspace.geojson
# itself IS committed (small, human-reviewable) -- only the pmtiles archive
# and the raw cache are excluded.
etl/data-sources/
etl/output/*.pmtiles

# Wrangler's local cache (account info, OAuth state) from running it in this
# directory -- machine-local, not project state.
.wrangler/

# Server dependencies -- reinstall with: cd server && npm install
server/node_modules/

# One-off Cloudflare API token (Access: Apps and Policies edit) used to
# script the Zero Trust setup in Phase H -- never committed.
server/.cf-access-admin-token
