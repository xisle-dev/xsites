# Build artifacts -- rebuild with e.g. cd tools/fetchairspace && go build .
tools/*/*.exe

# Regenerable Protomaps basemap extract (~200MB, over GitHub's file size
# limit anyway). Regenerate with go-pmtiles extract -- see README.md.
tiles/*.pmtiles
tiles/*.log

# Wrangler's local cache (account info, OAuth state) from running it in this
# directory -- machine-local, not project state.
.wrangler/

# Worker dependencies -- reinstall with: cd worker && npm install
worker/node_modules/

# One-off Cloudflare API token (Access: Apps and Policies edit) used to
# script the Zero Trust setup in Phase H -- never committed.
worker/.cf-access-admin-token
