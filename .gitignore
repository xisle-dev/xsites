# etl build artifact -- rebuild with: cd etl && go build -o etl.exe .
etl/etl.exe
etl/etl

# etl's raw-download cache and its outputs (airspace.geojson and the ~200MB
# PMTiles archive). Regenerate with `etl airspace` / `etl tiles` -- see
# README.md. DEV reads them from etl/output; Deploy builds its own for R2.
etl/data-sources/
etl/output/

# Wrangler's local cache (account info, OAuth state) from running it in this
# directory -- machine-local, not project state.
.wrangler/

# Server dependencies -- reinstall with: cd server && npm install
server/node_modules/

# DEV server data (go run ./dev), seeded from the backup branch
dev/data/
