# Cloud Build's source upload -- deliberately NOT deferring to .gitignore
# (the default behavior) because tiles/*.pmtiles is gitignored there only
# for being oversized for git, not because it's unwanted here: the Docker
# build actually needs the real file to bake into the image.
.git/
.github/
.claude/
.wrangler/
scratch_rasp_test/
sites/
static/
tools/
dist/
node_modules/
*.exe
*.exe~
*.log
server/.r2.local.env
